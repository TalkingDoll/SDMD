# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, and formatter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Generated experiment artifacts and model checkpoints
*.jbl
*.joblib
*.pkl
*.pickle
*.torch
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.h5
*.hdf5
*.mat

# Common experiment output directories
runs/
outputs/
checkpoints/
mlruns/
wandb/

# Keep the curated data directory trackable.
!data/
!data/**
